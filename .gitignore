# --- Python & Environment ---
venv/
.venv/
.venv-*/
.deps/
app_env/
__pycache__/
*.pyc
*.pyo
*.pyd
.env

# --- Pytest ---
.pytest_tmp/

# --- Pytest ---
.pytest_tmp/

# --- Qube Architecture: Models ---
models/**/*
!models/**/.gitkeep

# --- Router eval generated / local outputs ---
eval/.lancedb/
eval/cache/
# Local eval runs (regenerate via tools/evaluate_router.py)
eval/runs/*
!eval/runs/shadow_policy_baseline_v1/
!eval/runs/shadow_policy_baseline_v1/**

# --- Qube Architecture: Data ---
# Ignore all LanceDB / Vector storage files
data/**/*
# But do not ignore the .gitkeep files (if you use them to keep folders alive)
!data/**/.gitkeep
!models/**/.gitkeep

# --- Global Binary/Data Safety Net ---
*.onnx
*.bin
*.tflite
*.pb
*.weights
*.db
*.sqlite3
*.pt
*.gguf

# --- Configuration ---
# Keep project-level JSON configs, ignore deep model/metadata JSONs
models/**/*.json

# --- Build & Packaging ---
dist/
build/
*.egg-info/
installer/output/
winget/out/
chocolatey/out/
homebrew/out/

# --- IDE, OS & Tools ---
.vscode/
.idea/
.DS_Store
Thumbs.db
tools/test_outputs/

# --- Cursor ---
/.cursor/* # Allow the rules folder and everything inside it
!/.cursor/rules/
!/.cursor/rules/**

# --- Cursorrules ---
.cursorrules

# --- Clinerules ---
.clinerules

# --- Logs (runtime files stay local; app writes to ~/.qube/logs/) ---
*.log
*.log.*
logs/
logs/**/*
!logs/**/.gitkeep
# Runtime golden-trace captures (GOLDEN_TRACE_CAPTURE_MODE=1)
debug/golden_traces/
