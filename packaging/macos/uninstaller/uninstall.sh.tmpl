#!/bin/bash
# Remove Qube.app and user data. Generated by scripts/render_macos_uninstaller.py — do not edit.
set -euo pipefail

APP_PROCESS="Qube"
KEEP_USER_DATA="${QUBE_KEEP_USER_DATA:-0}"
QUIET="${QUBE_QUIET:-0}"

usage() {
  cat <<'EOF'
Usage: uninstall.sh [--quiet] [--keep-data]

  --quiet       Skip confirmation dialogs (for CI)
  --keep-data   Remove the app only; keep ~/.qube and other user data
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --quiet)
      QUIET=1
      shift
      ;;
    --keep-data)
      KEEP_USER_DATA=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ "$QUIET" != "1" ]]; then
  if [[ "$KEEP_USER_DATA" == "1" ]]; then
    PROMPT='Remove Qube from this Mac? Your models, library, and settings in ~/.qube will be kept.'
  else
    PROMPT='Remove Qube and all of its data from this Mac? This deletes downloaded models, conversations, library indexes, and settings.'
  fi
  CONFIRM=$(osascript <<EOF || true
try
  button returned of (display dialog "$PROMPT" buttons {"Cancel", "Uninstall"} default button "Uninstall" with icon caution with title "Uninstall Qube")
on error number -128
  "Cancel"
end try
EOF
)
  if [[ "$CONFIRM" != "Uninstall" ]]; then
    echo "Uninstall cancelled."
    exit 0
  fi
fi

if pgrep -x "$APP_PROCESS" >/dev/null 2>&1; then
  if [[ "$QUIET" != "1" ]]; then
    osascript -e "tell application \"$APP_PROCESS\" to quit" >/dev/null 2>&1 || true
  else
    pkill -x "$APP_PROCESS" >/dev/null 2>&1 || true
  fi
  for _ in $(seq 1 30); do
    pgrep -x "$APP_PROCESS" >/dev/null 2>&1 || break
    sleep 1
  done
  pkill -x "$APP_PROCESS" >/dev/null 2>&1 || true
fi

remove_path() {
  local target="$1"
  if [[ -e "$target" || -L "$target" ]]; then
    rm -rf "$target"
    echo "Removed $target"
  fi
}

# App bundle(s)
{{APP_REMOVE_LINES}}

if [[ "$KEEP_USER_DATA" != "1" ]]; then
  # User data and support files
{{DATA_REMOVE_LINES}}
fi

if [[ "$QUIET" != "1" ]]; then
  osascript -e 'display dialog "Qube has been removed." buttons {"OK"} default button "OK" with title "Uninstall Qube"' >/dev/null 2>&1 || true
fi

echo "Uninstall complete."
