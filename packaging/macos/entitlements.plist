<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Python and llama.cpp generate and execute code at runtime, so the
      hardened runtime must permit JIT and unsigned executable memory.
      Library validation is disabled because PyInstaller bundles third-party
      dynamic libraries (onnxruntime, ctranslate2, llama_cpp) that are not
      signed with Qube's Team ID.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Qube captures audio for voice input and wake-word detection. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
