#!/bin/bash
# Remove the Qube .deb install and optional user data. Generated by scripts/render_linux_uninstaller.py — do not edit.
set -euo pipefail

APP_PROCESS="Qube"
KEEP_USER_DATA=0
QUIET=0
CONFIRMED=0
QUBE_DEB_PACKAGES=(qube qube-vulkan qube-cuda)

usage() {
  cat <<'EOF'
Usage: uninstall.sh [--quiet] [--confirmed] [--keep-data]

  --quiet       Skip confirmation dialogs (for automation)
  --confirmed   Skip confirmation (caller already confirmed, e.g. in-app uninstall)
  --keep-data   Remove the packaged app only; keep ~/.qube
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --quiet)
      QUIET=1
      shift
      ;;
    --confirmed)
      CONFIRMED=1
      shift
      ;;
    --keep-data)
      KEEP_USER_DATA=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

detect_deb_package() {
  local pkg
  for pkg in "${QUBE_DEB_PACKAGES[@]}"; do
    if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed"; then
      echo "$pkg"
      return 0
    fi
  done
  return 1
}

run_privileged() {
  if [[ "$(id -u)" -eq 0 ]]; then
    "$@"
    return
  fi
  if command -v pkexec >/dev/null 2>&1; then
    pkexec "$@"
    return
  fi
  if command -v sudo >/dev/null 2>&1; then
    sudo "$@"
    return
  fi
  echo "Administrator privileges are required to remove the Qube package." >&2
  echo "Re-run: sudo qube-uninstall" >&2
  exit 1
}

confirm_uninstall() {
  local prompt="$1"
  if [[ "$QUIET" == "1" || "$CONFIRMED" == "1" ]]; then
    return 0
  fi
  if command -v zenity >/dev/null 2>&1; then
    if zenity --question --title="Uninstall Qube" --text="$prompt" --ok-label="Uninstall" --cancel-label="Cancel"; then
      return 0
    fi
    echo "Uninstall cancelled."
    exit 0
  fi
  if command -v kdialog >/dev/null 2>&1; then
    if kdialog --title "Uninstall Qube" --yesno "$prompt"; then
      return 0
    fi
    echo "Uninstall cancelled."
    exit 0
  fi
  if [[ -t 0 ]]; then
    echo "$prompt"
    read -r -p "Type UNINSTALL to continue: " reply
    if [[ "$reply" == "UNINSTALL" ]]; then
      return 0
    fi
    echo "Uninstall cancelled."
    exit 0
  fi
  echo "No display available for confirmation. Re-run with --quiet or --confirmed." >&2
  exit 1
}

notify_done() {
  local message="$1"
  if [[ "$QUIET" == "1" || "$CONFIRMED" == "1" ]]; then
    return 0
  fi
  if command -v zenity >/dev/null 2>&1; then
    zenity --info --title="Uninstall Qube" --text="$message" >/dev/null 2>&1 || true
    return 0
  fi
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "Uninstall Qube" --msgbox "$message" >/dev/null 2>&1 || true
  fi
}

stop_qube() {
  if pgrep -x "$APP_PROCESS" >/dev/null 2>&1; then
    pkill -x "$APP_PROCESS" >/dev/null 2>&1 || true
    for _ in $(seq 1 30); do
      pgrep -x "$APP_PROCESS" >/dev/null 2>&1 || break
      sleep 1
    done
    pkill -9 -x "$APP_PROCESS" >/dev/null 2>&1 || true
  fi
}

remove_path() {
  local target="$1"
  # Expand $HOME when rendered paths use it.
  eval "target=\"$target\""
  if [[ -e "$target" || -L "$target" ]]; then
    rm -rf "$target"
    echo "Removed $target"
  fi
}

remove_deb_package() {
  local pkg="$1"
  if command -v apt-get >/dev/null 2>&1; then
    run_privileged apt-get remove -y "$pkg"
    return
  fi
  if command -v apt >/dev/null 2>&1; then
    run_privileged apt remove -y "$pkg"
    return
  fi
  run_privileged dpkg -r "$pkg"
}

if [[ "$KEEP_USER_DATA" == "1" ]]; then
  confirm_uninstall "Remove Qube from this system? Your models, library, and settings in ~/.qube will be kept."
else
  confirm_uninstall "Remove Qube and all of its data from this system? This deletes downloaded models, conversations, library indexes, and settings."
fi

stop_qube

if deb_pkg="$(detect_deb_package)"; then
  echo "Removing Debian package: $deb_pkg"
  remove_deb_package "$deb_pkg"
else
  echo "No Qube .deb package detected; removing installed files directly."
{{APP_REMOVE_LINES}}
fi

if [[ "$KEEP_USER_DATA" != "1" ]]; then
{{DATA_REMOVE_LINES}}
fi

notify_done "Qube has been removed."
echo "Uninstall complete."
